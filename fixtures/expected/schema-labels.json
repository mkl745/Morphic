        },
        "line": {
          "dtype": "utf8",
          "role": "text"
        }
      },
      "note": "line_number is an ordinal that identifies a row, not a quantity to sum."
    },
    {
      "path": "valid/records.json",
      "format": "json",
      "fields": {
        "id": {
          "dtype": "int64",
          "role": "identifier"
        },
        "metric": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "value": {
          "dtype": "float64",
          "role": "measure"
        },
        "host": {
          "dtype": "utf8",
          "role": "dimension"
        }
      }
    },
    {
      "path": "valid/semicolon.csv",
      "format": "csv",
      "fields": {
        "region": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "revenue": {
          "dtype": "float64",
          "role": "measure"
        },
        "units": {
          "dtype": "int64",
          "role": "measure"
        }
      }
    },
    {
      "path": "valid/server_logs.log",
      "format": "log",
      "fields": {
        "time": {
          "dtype": "timestamp",
          "role": "temporal"
        },
        "level": {
          "dtype": "utf8",
          "role": "severity"
        },
        "service": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "message": {
          "dtype": "utf8",
