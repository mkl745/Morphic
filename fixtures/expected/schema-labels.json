        },
        "latency": {
          "dtype": "int64",
          "role": "measure"
        }
      }
    },
    {
      "path": "valid/single_object.json",
      "format": "json",
      "fields": {
        "service": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "version": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "healthy": {
          "dtype": "bool",
          "role": "dimension"
        },
        "limits.rpm": {
