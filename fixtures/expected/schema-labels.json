          "role": "measure"
        },
        "limits.burst": {
          "dtype": "int64",
          "role": "measure"
        }
      },
      "note": "A version string is a label, not a number. One row, so cardinality proves nothing."
    },
    {
      "path": "valid/syslog.log",
      "format": "log",
      "fields": {
        "time": {
          "dtype": "utf8",
          "role": "temporal"
        },
        "level": {
          "dtype": "utf8",
          "role": "severity"
        },
        "host": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "service": {
          "dtype": "utf8",
          "role": "dimension"
        },
        "pid": {
          "dtype": "int64",
          "role": "identifier"
        },
        "message": {
          "dtype": "utf8",
          "role": "text"
        }
      },
      "note": "RFC3164 time has no year and stays utf8; the role is still temporal. pid identifies a process even though only two lines carry one."
    },
    {
      "path": "valid/tab.tsv",
      "format": "csv",
      "fields": {
